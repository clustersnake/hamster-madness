local constants = require "shared.constants"

local last_dir = "down"

function init(self)
	msg.post('.', 'acquire_input_focus')
	self.input = vmath.vector3() -- Para acumular input
	self.dir = vmath.vector3()   -- Para el movimiento final
	self.current_anim = nil

	self.data = {
		state = constants.PLAYER_VULNERABLE,
		speed = constants.PLAYER_SPEED
	}
	msg.post("#shield", "disable")
end

local function get_animation(self, is_moving)
	if is_moving then
		-- Usamos la dirección real del movimiento para la animación
		if math.abs(self.dir.x) > math.abs(self.dir.y) then
			last_dir = self.dir.x > 0 and "right" or "left"
		else
			last_dir = self.dir.y > 0 and "up" or "down"
		end
		return hash("walk_" .. last_dir)
	end
	return hash('idle_' .. last_dir)
end

function update(self, dt)
	-- 1. Normalizar para diagonales perfectas
	if vmath.length_sqr(self.input) > 0 then
		self.dir = vmath.normalize(self.input)
	else
		self.dir = vmath.vector3(0,0,0)
	end

	-- 2. Movimiento
	local p = go.get_position()
	go.set_position(p + self.dir * self.data.speed * dt)

	-- 3. Animaciones
	local is_moving = vmath.length_sqr(self.dir) > 0
	local anim = get_animation(self, is_moving)

	if anim ~= self.current_anim then
		sprite.play_flipbook("#body", anim)
		self.current_anim = anim
	end

	-- 4. Limpiar input para el próximo frame
	self.input = vmath.vector3()
end

function on_message(self, message_id, message, sender)
	if message_id == hash("contact_point_response") then
		-- A. RECOGER BOLA
		if message.other_group == hash("ball") and self.data.state == constants.PLAYER_VULNERABLE then
			self.data.state = constants.PLAYER_PROTECTED
			self.data.speed = constants.PLAYER_PROTECTED_SPEED
			msg.post("#shield", "enable")
			go.delete(message.other_id)
			print("¡Protegido!")

			-- B. CHOCAR CON PARED (Solución punto 4)
		elseif message.group == hash("wall") then
			-- Empujamos al jugador fuera de la pared por la distancia de penetración
			local new_pos = go.get_position() + message.normal * message.distance
			go.set_position(new_pos)
		end
	end
end

function on_input(self, action_id, action)
	-- Acumular movimiento
	if action_id == hash("move_up") then self.input.y = 1
	elseif action_id == hash("move_down") then self.input.y = -1
	elseif action_id == hash("move_left") then self.input.x = -1
	elseif action_id == hash("move_right") then self.input.x = 1
	end

	-- Disparo (Punto 2 arreglado)
	if action_id == hash("action_shoot") and action.pressed then
		if self.data.state == constants.PLAYER_PROTECTED then
			self.data.state = constants.PLAYER_VULNERABLE
			self.data.speed = constants.PLAYER_SPEED
			msg.post("#shield", "disable")

			-- Si nos movemos, disparamos en esa diagonal. Si no, a donde miramos.
			local shot_dir = vmath.length_sqr(self.dir) > 0 and self.dir or vmath.vector3()

			if vmath.length_sqr(shot_dir) == 0 then
				if last_dir == "up" then shot_dir.y = 1
				elseif last_dir == "down" then shot_dir.y = -1
				elseif last_dir == "left" then shot_dir.x = -1
				elseif last_dir == "right" then shot_dir.x = 1
				end
			end

			-- Punto 1: Offset de 60 para seguridad
			local spawn_pos = go.get_position() + (shot_dir * 60)
			factory.create("/spawner#ball_factory", spawn_pos, nil, { 
				direction = shot_dir, 
				speed = constants.BALL_SHOT_SPEED 
			})
			self.current_anim = nil
		end
	end
end

