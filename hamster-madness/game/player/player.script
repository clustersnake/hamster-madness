local constants = require "shared.constants"
local tracker = require "shared.tracker"

local DIR_VECTORS = {
	["up"]    = vmath.vector3(0, 1, 0),
	["down"]  = vmath.vector3(0, -1, 0),
	["left"]  = vmath.vector3(-1, 0, 0),
	["right"] = vmath.vector3(1, 0, 0)
}

-- 1. Función para disparar voluntariamente
local function shoot_ball(self, direction, speed, offset, range)
	self.data.state = constants.PLAYER_VULNERABLE
	self.data.speed = constants.PLAYER_SPEED
	tracker.active_player_state = self.data.state -- Sincronizamos tracker
	msg.post("#shield", "disable")
	self.current_anim = nil

	local spawn_pos = go.get_position() + (direction * offset)
	factory.create("/spawner#ball_factory", spawn_pos, nil, { 
		direction = direction, 
		speed = speed,
		max_distance = range
	})
end

-- 2. Función para cuando el escudo es removido por daño
local function drop_shield(self, enemy_pos)
	self.data.invulnerable_timer = self.data.invulnerable_duration
	local my_pos = go.get_position()
	local expel_dir = vmath.normalize(my_pos - enemy_pos)
	shoot_ball(self, expel_dir, constants.BALL_EXPELLED_SPEED, 60, constants.BALL_RANGE_EXPELLED)
	self.velocity = expel_dir * 150
end

function init(self)
	msg.post('.', 'acquire_input_focus')
	self.input = vmath.vector3() 
	self.dir = vmath.vector3()
	self.last_dir = "down"
	self.current_anim = nil

	self.data = {
		state = constants.PLAYER_VULNERABLE,
		speed = constants.PLAYER_SPEED,
		invulnerable_timer = 0,
		invulnerable_duration = 1.5
	}
	msg.post("#shield", "disable")

	-- REGISTRO INICIAL EN EL TRACKER
	tracker.active_player_id = go.get_id()
	tracker.active_player_state = self.data.state

	print("LOG: Hámster en línea - Estado: VULNERABLE")
end

local function get_animation(self, is_moving)
	if is_moving then
		if math.abs(self.dir.x) > math.abs(self.dir.y) then
			self.last_dir = self.dir.x > 0 and "right" or "left"
		else
			self.last_dir = self.dir.y > 0 and "up" or "down"
		end
		return hash("walk_" .. self.last_dir)
	end
	return hash('idle_' .. self.last_dir)
end

function update(self, dt)
	-- Manejo de invulnerabilidad visual
	if self.data.invulnerable_timer > 0 then
		self.data.invulnerable_timer = self.data.invulnerable_timer - dt
		local alpha = math.sin(os.clock() * 20) > 0 and 1 or 0.3
		go.set("#body", "tint", vmath.vector4(1, 1, 1, alpha))
		if self.data.invulnerable_timer <= 0 then
			go.set("#body", "tint", vmath.vector4(1, 1, 1, 1))
		end
	end

	-- Bloqueo total si está herido
	-- if self.data.state == constants.PLAYER_WOUNDED then return end

	if vmath.length_sqr(self.input) > 0 then
		self.dir = vmath.normalize(self.input)
	else
		self.dir = vmath.vector3(0,0,0)
	end

	local p = go.get_position()
	go.set_position(p + self.dir * self.data.speed * dt)

	local is_moving = vmath.length_sqr(self.dir) > 0
	local anim = get_animation(self, is_moving)

	if anim ~= self.current_anim then
		sprite.play_flipbook("#body", anim)
		self.current_anim = anim
	end
	self.input = vmath.vector3()
end

function on_message(self, message_id, message, sender)
	-- 1. PRIORIDAD: RESCATE (Funciona incluso si el resto está bloqueado)
	if message_id == hash("contact_point_response") then

		-- RECOGER BOLA
		if message.other_group == hash("ball") and self.data.state == constants.PLAYER_VULNERABLE then
			self.data.state = constants.PLAYER_PROTECTED
			tracker.active_player_state = self.data.state -- Sincronizamos tracker
			self.data.speed = constants.PLAYER_PROTECTED_SPEED
			msg.post("#shield", "enable")
			go.delete(message.other_id)
		end

		if message.other_group == hash("walls") or message.other_group == hash("wall") then
			if message.distance > 0 then
				-- Calculamos cuánto debemos empujar al personaje hacia afuera
				local projection = vmath.project(self.velocity or vmath.vector3(), message.normal * message.distance)
				if projection < 1 then
					local comp = (message.distance - projection) * message.normal
					-- Aplicamos la corrección de posición inmediatamente
					go.set_position(go.get_position() + comp)
				end
			end
		end
	end

	-- 2. BLOQUEO: Si ya estamos heridos, no procesamos daño
	-- if self.data.state == constants.PLAYER_WOUNDED then return end

	-- 3. LÓGICA DE DAÑO
	if message_id == hash("take_damage") and self.data.invulnerable_timer <= 0 then
		if self.data.state == constants.PLAYER_PROTECTED then
			drop_shield(self, go.get_position(sender))
		else
			-- CAER HERIDO

			local pos = go.get_position()

			factory.create("/spawner#wounded_factory", pos)

			go.delete()

			msg.post("/spawner#spawner", "hamster_down")
			print("LOG: ¡Hámster herido! Solicitando relevo...")
		end
	end
end

function on_input(self, action_id, action)
	-- if self.data.state == constants.PLAYER_WOUNDED then return end

	if action_id == hash("move_up") then self.input.y = 1
	elseif action_id == hash("move_down") then self.input.y = -1
	elseif action_id == hash("move_left") then self.input.x = -1
	elseif action_id == hash("move_right") then self.input.x = 1
	end

	if action_id == hash("action_shoot") and action.pressed and self.data.state == constants.PLAYER_PROTECTED then
		local is_moving = vmath.length_sqr(self.dir) > 0
		local shot_dir = is_moving and self.dir or DIR_VECTORS[self.last_dir]
		shoot_ball(self, shot_dir, constants.BALL_SHOT_SPEED, 60, constants.BALL_RANGE_SHOT)
	end
end