-- dropped_shield.script
-- Escudo caído - estático, solo recolectable

function init(self)
	print("Escudo caído creado - esperando ser recogido")
end

function on_message(self, message_id, message, sender)
	-- Trigger usa "trigger_response" en lugar de "contact_point_response"
	if message_id == hash("trigger_response") then
		-- Recogida por el jugador
		if message.group == hash("player") then
			print("¡Escudo recogido!")
			msg.post(message.other_id, "projectile_picked_up")
			go.delete()
		end
	end
end