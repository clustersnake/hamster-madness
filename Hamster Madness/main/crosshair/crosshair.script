-- crosshair.script

local camera = require "orthographic.camera"

function init(self)
	msg.post(".", "acquire_input_focus")

	self.camera_id = go.get_id("/camera")
	self.mouse_pos = vmath.vector3(0, 0, 0)

	if window and window.set_cursor_visible then
		window.set_cursor_visible(false)
	end
end

function final(self)
	if window and window.set_cursor_visible then
		window.set_cursor_visible(true)
	end
end

function update(self, dt)
	local world_pos = camera.screen_to_world(self.camera_id, self.mouse_pos)

	if world_pos then
		go.set_position(vmath.vector3(world_pos.x, world_pos.y, 0.9))
	end
end

function on_input(self, action_id, action)
	-- Solo actualizar si hay coordenadas de mouse (no en eventos de teclado)
	if action.x and action.y then
		self.mouse_pos.x = action.x
		self.mouse_pos.y = action.y
		self.mouse_pos.z = 0
	end
end