-- projectile.script
-- Disparo activo - rebota, mata enemigos, puede ser REFLEJADO

go.property("speed", 400)
go.property("max_distance", 500)

function init(self)
	self.direction = vmath.vector3(0, 0, 0)
	self.is_moving = false
	self.distance_traveled = 0

	self.bounce_cooldown = 0
	self.cooldown_time = 0.05

	-- Parry / Reflejo
	self.is_reflected = false

	-- Evitar doble muerte
	self.is_dying = false

	print("Projectile creado")
end

-- ═══════════════════════════════════════
-- FUNCIÓN CENTRALIZADA DE MUERTE
-- ═══════════════════════════════════════
local function die(self)
	-- Evitar llamadas múltiples
	if self.is_dying then
		return
	end
	self.is_dying = true

	-- Si está reflejado, simplemente desaparece
	if self.is_reflected then
		print("Proyectil reflejado expiró")
		go.delete()
		return
	end

	-- Normal: convertirse en dropped_shield
	print("Projectile → Dropped shield")
	local pos = go.get_position()
	factory.create("#dropped_shield_factory", pos)
	go.delete()
end

function update(self, dt)
	if self.is_dying then
		return
	end

	if self.bounce_cooldown > 0 then
		self.bounce_cooldown = self.bounce_cooldown - dt
	end

	if self.is_moving then
		local movement_distance = self.speed * dt
		local movement = self.direction * movement_distance

		local current_pos = go.get_position()
		go.set_position(current_pos + movement)

		self.distance_traveled = self.distance_traveled + movement_distance

		-- Alcanzó distancia máxima
		if self.distance_traveled >= self.max_distance then
			die(self)
		end
	end
end

function on_message(self, message_id, message, sender)
	if self.is_dying then
		return
	end

	-- ═══════════════════════════════════════
	-- DISPARO INICIAL
	-- ═══════════════════════════════════════
	if message_id == hash("fire") then
		self.direction = vmath.normalize(message.direction)
		self.is_moving = true
		self.is_reflected = false
		self.distance_traveled = 0
		self.bounce_cooldown = 0
		print("Projectile disparado! Distancia máx: " .. self.max_distance .. "px")
		return
	end

	-- ═══════════════════════════════════════
	-- REFLEJO (PARRY DEL BOSS)
	-- ═══════════════════════════════════════
	if message_id == hash("reflect") then
		print("¡¡PROYECTIL REFLEJADO!!")

		self.direction = vmath.normalize(message.direction)
		self.is_reflected = true
		self.distance_traveled = 0
		self.speed = self.speed * 1.3

		sprite.set_constant("#sprite", "tint", vmath.vector4(1, 0.4, 0.2, 1))
		return
	end

	-- ═══════════════════════════════════════
	-- DESTRUCCIÓN FORZADA
	-- ═══════════════════════════════════════
	if message_id == hash("destroy") then
		die(self)
		return
	end

	-- ═══════════════════════════════════════
	-- COLISIONES
	-- ═══════════════════════════════════════
	if message_id == hash("contact_point_response") then

		-- Rebote en paredes
		if message.group == hash("default") then
			if self.is_moving and self.bounce_cooldown <= 0 then
				local normal = message.normal
				local dot = vmath.dot(self.direction, normal)
				self.direction = self.direction - 2 * dot * normal
				self.direction = vmath.normalize(self.direction)

				local correction = normal * message.distance
				local current_pos = go.get_position()
				go.set_position(current_pos + correction)

				self.bounce_cooldown = self.cooldown_time
				print("Projectile rebote!")
			end
			return
		end

		-- Impacto con enemigo (solo si NO está reflejado)
-- 		if message.group == hash("enemy") and not self.is_reflected then
-- 			print("Projectile impactó enemigo!")
-- 			msg.post(message.other_id, "take_damage")
-- 
-- 			-- Rebote suave hacia atrás
-- 			-- self.direction = -self.direction
-- 			-- self.speed = self.speed * 0.25
-- 			-- self.max_distance = self.distance_traveled + 100
-- 			return
-- 		end

		-- Impacto con enemigo (solo si NO está reflejado)
		if message.group == hash("enemy") and not self.is_reflected then
			print("Projectile impactó enemigo!")
			msg.post(message.other_id, "take_damage")

			-- 1. Detener el movimiento para que no siga atravesando
			self.is_moving = false

			-- 2. Pequeño rebote visual instantáneo (opcional pero recomendado)
			-- Esto evita que el escudo aparezca "dentro" del collider del enemigo
			local pos = go.get_position()
			local separation = message.normal * 30 -- Se aleja 30px del punto de impacto
			go.set_position(pos + separation)

			-- 3. Morir inmediatamente y convertirse en escudo
			die(self)
			return
		end

		-- Impacto con jugador (solo si ESTÁ reflejado)
		if message.group == hash("player") and self.is_reflected then
			print("¡Proyectil reflejado impactó al jugador!")
			msg.post(message.other_id, "enemy_damage", {
				damage = 1,
				enemy_position = go.get_position()
			})
			die(self)
			return
		end

		return
	end
end