-- hud.gui_script
-- HUD del juego con sistema de cola de personajes

local i18n = require "main.data.localization"

-- ============================================================
-- FORWARD DECLARATIONS
-- ============================================================

local update_next_queue
local update_mode
local update_shield
local update_wave_display
local show_message
local update_character_display
local update_portraits

-- Mapeo de character_id a nombre de imagen en el atlas
local PORTRAITS = {
	tank = "portrait_tank",
	speedy = "portrait_speedy",
	default = "portrait_default",
}

-- ============================================================
-- INIT
-- ============================================================

function init(self)
	-- Cola de personajes
	self.characters_remaining = 1  -- Personajes en reserva (sin contar el activo)
	self.next_character_id = nil   -- ID del siguiente personaje

	-- Estado del juego
	self.wave = 1
	self.has_shield = false
	self.mode = "normal"
	self.current_character_id = nil

	-- Timer para mensajes temporales
	self.message_timer = nil

	self.current_character_id = nil
	self.next_character_id = nil

	-- Inicializar textos en el idioma correcto
	gui.set_text(gui.get_node("label_next"), i18n.t("next"))
	gui.set_text(gui.get_node("label_wave"), i18n.t("wave"))
	gui.set_text(gui.get_node("label_shield"), i18n.t("shield"))
end

-- ============================================================
-- COLA DE PERSONAJES (antes era "vidas")
-- ============================================================

update_next_queue = function(self)
	local count_node = gui.get_node("next_count")

	if self.characters_remaining <= 0 then
		-- No hay más personajes en reserva
		gui.set_text(count_node, i18n.t("last"))
		gui.set_color(count_node, vmath.vector4(1, 0.3, 0.3, 1))  -- Rojo de advertencia
	elseif self.characters_remaining == 1 then
		-- Queda 1 en reserva
		gui.set_text(count_node, "+1")
		gui.set_color(count_node, vmath.vector4(1, 0.8, 0.2, 1))  -- Amarillo
	else
		-- Quedan varios
		gui.set_text(count_node, "+" .. self.characters_remaining)
		gui.set_color(count_node, vmath.vector4(0.4, 0.83, 0.57, 1))  -- Verde
	end
end

-- ============================================================
-- PERSONAJE ACTUAL
-- ============================================================

update_character_display = function(self, character_id, character_name)
	self.current_character_id = character_id

	-- Actualizar el área del rostro si existe
	-- Por ahora podemos usar el nodo face_area para mostrar info
	-- En el futuro: cambiar sprite del retrato

	print("[HUD] Personaje activo: " .. (character_name or character_id))
end

-- ============================================================
-- OLEADA
-- ============================================================

update_wave_display = function(self)
	gui.set_text(gui.get_node("wave_count"), tostring(self.wave))
end

-- ============================================================
-- ESCUDO
-- ============================================================

update_shield = function(self, has_shield)
	self.has_shield = has_shield
	local status_node = gui.get_node("shield_status")

	if has_shield then
		gui.set_text(status_node, i18n.t("ready"))
		gui.set_color(status_node, vmath.vector4(0.4, 0.83, 0.57, 1))  -- Verde
	else
		gui.set_text(status_node, "---")
		gui.set_color(status_node, vmath.vector4(0.5, 0.5, 0.5, 1))  -- Gris
	end
end

-- ============================================================
-- MODO DE JUEGO
-- ============================================================

update_mode = function(self, mode)
	self.mode = mode
	local diff_node = gui.get_node("difficulty")

	if mode == "rescue" then
		gui.set_text(diff_node, i18n.t("rescue"))
		gui.set_color(diff_node, vmath.vector4(1, 0.4, 0.4, 1))  -- Rojo
	elseif mode == "boss" then
		gui.set_text(diff_node, i18n.t("boss"))
		gui.set_color(diff_node, vmath.vector4(1, 0.5, 0, 1))  -- Naranja
	elseif mode == "victory" then
		gui.set_text(diff_node, i18n.t("victory"))
		gui.set_color(diff_node, vmath.vector4(1, 0.84, 0, 1))  -- Dorado
	else
		gui.set_text(diff_node, i18n.t("normal"))
		gui.set_color(diff_node, vmath.vector4(1, 1, 1, 1))  -- Blanco
	end
end

-- ============================================================
-- MENSAJES TEMPORALES
-- ============================================================

show_message = function(self, text, duration)
	local diff_node = gui.get_node("difficulty")

	gui.set_text(diff_node, text)
	gui.set_color(diff_node, vmath.vector4(1, 1, 0, 1))  -- Amarillo

	-- Cancelar timer anterior si existe
	if self.message_timer then
		timer.cancel(self.message_timer)
	end

	-- Restaurar después de duration
	self.message_timer = timer.delay(duration, false, function()
		update_mode(self, self.mode)
	end)
end

-- ============================================================
-- ON MESSAGE
-- ============================================================

function on_message(self, message_id, message, sender)
	-- Actualizar cola de personajes (reemplaza update_lives)
	if message_id == hash("update_lives") then
		-- Compatibilidad: lives ahora representa personajes restantes
		self.characters_remaining = message.lives - 1  -- -1 porque no contamos al activo
		update_next_queue(self)
		return
	end

	-- NUEVO: Actualizar cola con información detallada
	if message_id == hash("update_character_queue") then
		self.characters_remaining = message.remaining
		self.next_character_id = message.next_character_id
		update_next_queue(self)
		update_portraits(self)
		return
	end

	-- NUEVO: Personaje activo cambió
	if message_id == hash("update_current_character") then
		self.current_character_id = message.character_id
		update_character_display(self, message.character_id, message.character_name)
		update_portraits(self)
		return
	end

	if message_id == hash("update_wave") then
		self.wave = message.wave
		update_wave_display(self)
		return
	end

	if message_id == hash("update_shield") then
		update_shield(self, message.has_shield)
		return
	end

	if message_id == hash("update_mode") then
		update_mode(self, message.mode)
		return
	end

	if message_id == hash("show_message") then
		show_message(self, message.text, message.duration)
		return
	end

	-- NUEVO: Level up notification
	if message_id == hash("level_up") then
		local text = message.character_name .. " " .. i18n.t("level_up") .. " " .. message.new_level
		show_message(self, text, 1.5)
		return
	end
end

update_portraits = function(self)
	local face_node = gui.get_node("face_area")
	local next_node = gui.get_node("next_area")

	-- Actualizar retrato del personaje activo
	if self.current_character_id then
		local portrait = PORTRAITS[self.current_character_id] or PORTRAITS.default
		gui.play_flipbook(face_node, portrait)
	end

	-- Actualizar retrato del siguiente en cola
	if self.next_character_id then
		local portrait = PORTRAITS[self.next_character_id] or PORTRAITS.default
		gui.play_flipbook(next_node, portrait)
		gui.set_enabled(next_node, true)
	else
		-- No hay siguiente, ocultar o mostrar default
		gui.play_flipbook(next_node, PORTRAITS.default)
		gui.set_enabled(next_node, false)
	end
end
