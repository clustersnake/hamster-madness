local level_layout = require "main.data.level_layout"
local camera = require "main.camera.camera"

local FACTORY_URLS = {
	room_small  = "#room_small_factory",
	room_medium = "#room_medium_factory",
	room_large  = "#room_large_factory",
	room_boss   = "#room_boss_factory",
}

-- Forward declarations
local transition_to_room
local delete_current_room
local create_room_instance
local position_player_at_door
local configure_room_doors
local configure_camera
local configure_wave_manager

function init(self)
	self.current_instance = nil
	self.current_room_id = nil
	self.is_transitioning = false
	self.grace_frames = 0
	self.player_id = nil
	self.current_doors = {}
	self.pending_door_states = {}

	level_layout.init()

	transition_to_room(self, "hub", nil)
end

function update(self, dt)
	if self.grace_frames > 0 then
		self.grace_frames = self.grace_frames - 1
	end
end

transition_to_room = function(self, room_id, entered_from)
	if self.is_transitioning then
		return
	end
	self.is_transitioning = true

	local room_data = level_layout.get_room(room_id)
	if not room_data then
		print("[LevelManager] ERROR: Sala no encontrada: " .. tostring(room_id))
		self.is_transitioning = false
		return
	end

	timer.delay(0.15, false, function()
		if not go.exists(go.get_id()) then return end

		delete_current_room(self)

		create_room_instance(self, room_data)

		self.current_room_id = room_id
		level_layout.current_room_id = room_id
		level_layout.room_states[room_id].visited = true
		self.current_doors = {}

		position_player_at_door(self, entered_from, room_data)

		configure_room_doors(self, room_id)
		configure_camera(self, room_data)
		configure_wave_manager(self, room_id)

		self.is_transitioning = false
		self.grace_frames = 5
		print("[LevelManager] Transición completada: " .. tostring(room_id))
		msg.post("/hud#hud", "update_room_id", { room_id = room_id })
	end)
end

delete_current_room = function(self)
	if self.current_instance then
		print("[LevelManager] Eliminando sala: " .. tostring(self.current_instance))
		go.delete(self.current_instance)
		self.current_instance = nil
	end
end

create_room_instance = function(self, room_data)
	local factory_id = FACTORY_URLS[room_data.template]
	if not factory_id then
		print("[LevelManager] ERROR: Factory no encontrada: " .. tostring(room_data.template))
		return nil
	end

	self.current_instance = collectionfactory.create(factory_id)
	print("[LevelManager] Sala creada: " .. tostring(room_data.template) .. " | ID: " .. tostring(self.current_instance))
	return self.current_instance
end

position_player_at_door = function(self, entered_from, room_data)
	if not entered_from then
		return
	end

	local opposite = level_layout.opposite_door[entered_from]
	local door_pos = level_layout.door_positions[opposite]
	local offset = level_layout.door_offsets[opposite]
	if not (door_pos and offset) then
		return
	end

	local spawn_pos = vmath.vector3(
		door_pos.x + offset.x,
		door_pos.y + offset.y,
		0.2
	)

	local player_id = self.player_id
	if player_id and go.exists(player_id) then
		go.set_position(spawn_pos, player_id)
		print("[LevelManager] Jugador reposicionado en: (" .. spawn_pos.x .. ", " .. spawn_pos.y .. ")")
	end
end

configure_room_doors = function(self, room_id)
	local room_data = level_layout.get_room(room_id)
	local state = level_layout.get_state(room_id)

	for dir, target_id in pairs(room_data.doors) do
		local action = "lock"
		if state.cleared then
			action = "unlock"
		end
		local door_id = self.current_doors[dir]
		if door_id and go.exists(door_id) then
			msg.post(door_id, action)
			print("[LevelManager] Puerta " .. dir .. " -> " .. action)
		else
			print("[LevelManager] Puerta " .. dir .. " no registrada aun, guardando acción: " .. action)
			self.pending_door_states = self.pending_door_states or {}
			self.pending_door_states[dir] = action
		end
	end
end

configure_camera = function(self, room_data)
	local camera_id = go.get_id("/camera")

	if room_data.scrollable then
		local player_id = self.player_id
		if player_id and go.exists(player_id) then
			camera.follow(camera_id, player_id)
		end
	else
		local center = room_data.camera_center or { x = 640, y = 360 }
		go.set_position(vmath.vector3(center.x, center.y, 0), camera_id)
	end

	if room_data.camera_bounds then
		camera.bounds(
			camera_id,
			room_data.camera_bounds.left,
			room_data.camera_bounds.bottom,
			room_data.camera_bounds.right,
			room_data.camera_bounds.top
		)
	end
end

configure_wave_manager = function(self, room_id)
	local room_data = level_layout.get_room(room_id)

	msg.post("/wave_manager", "configure_room", {
		room = room_data,
		room_id = room_id,
		difficulty = room_data.difficulty or 0,
		is_boss = room_data.is_boss or false,
	})

	if room_data.difficulty and room_data.difficulty > 0 then
		msg.post("/wave_manager", "start_waves")
	else
		msg.post("/wave_manager", "stop_waves")
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("player_entered_door") then
		print("[LevelManager] player_entered_door: dir=" .. tostring(message.direction) .. " nombre=" .. tostring(message.direction_name) .. " sender=" .. tostring(sender))
		if self.is_transitioning then
			print("[LevelManager] Ignorando: transición en curso")
			return
		end

		if self.grace_frames > 0 then
			print("[LevelManager] Ignorando: periodo de gracia (" .. self.grace_frames .. " frames restantes)")
			return
		end

		local room_data = level_layout.get_current_room()
		if not room_data then
			print("[LevelManager] ERROR: Sin sala actual (current_room_id=" .. tostring(level_layout.current_room_id) .. ")")
			return
		end

		print("[LevelManager] Sala actual: " .. tostring(level_layout.current_room_id) .. " | Buscando puerta: " .. tostring(message.direction))
		local target_id = room_data.doors[message.direction]
		print("[LevelManager] target_id encontrado: " .. tostring(target_id))
		if not target_id then
			print("[LevelManager] Sin sala en dirección: " .. tostring(message.direction))
			return
		end

		self.current_doors = {}
		self.pending_door_states = {}

		print("[LevelManager] Iniciando transición: " .. tostring(self.current_room_id) .. " -> " .. tostring(target_id))
		transition_to_room(self, target_id, message.direction)
		return
	end

	if message_id == hash("door_ready") then
		local dir = message.direction
		self.current_doors[dir] = message.id
		print("[LevelManager] Puerta registrada: " .. tostring(dir) .. " ID=" .. tostring(message.id))

		if self.pending_door_states and self.pending_door_states[dir] then
			local action = self.pending_door_states[dir]
			print("[LevelManager] Aplicando acción pendiente a " .. dir .. " -> " .. action)
			msg.post(message.id, action)
			self.pending_door_states[dir] = nil
		end
		return
	end

	if message_id == hash("set_player_id") then
		self.player_id = message.player_id
		print("[LevelManager] Player ID recibido: " .. tostring(self.player_id))
		return
	end

	if message_id == hash("room_cleared") then
		local room_id = message.room_id or self.current_room_id
		local state = level_layout.get_state(room_id)
		if state then
			state.cleared = true
			print("[LevelManager] Sala limpiada: " .. tostring(room_id))
		end

		configure_room_doors(self, self.current_room_id)

		msg.post("/hud#hud", "show_message", {
			text = "¡SALA LIMPIADA!",
			duration = 1.5
		})
		return
	end

	if message_id == hash("boss_defeated_in_room") then
		local room_id = message.room_id or self.current_room_id
		local state = level_layout.get_state(room_id)
		if state then
			state.boss_defeated = true
			state.cleared = true
			print("[LevelManager] Boss derrotado en sala: " .. tostring(room_id))
		end

		configure_room_doors(self, self.current_room_id)
		return
	end
end
