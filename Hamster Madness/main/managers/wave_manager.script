-- wave_manager.script
-- Controla el spawn de enemigos y las oleadas

local room_data = require "main.data.room_data"
local i18n = require "main.data.localization"

local BOSS_TRIGGER_WAVE = 5  -- El boss aparece después de esta oleada

-- ============================================================
-- FACTORIES DE ENEMIGOS
-- ============================================================

local ENEMY_FACTORIES = {
	chaser = "#chaser_factory",
	shooter = "#shooter_factory",
}

-- Forward declarations
local start_next_wave
local spawn_enemy
local get_enemy_type_for_wave
local on_wave_complete
local on_rescue_waves_complete
local start_rescue_mode
local end_rescue_mode
local get_valid_spawn_points
local get_player_position
local clear_all_enemies  -- NUEVO: Forward declaration

-- Configuración de oleadas BALANCEADA
local WAVE_CONFIG = {
	normal = {
		-- Fase de aprendizaje (oleadas 1-3): solo chasers
		{enemies = 2, spawn_delay = 0.6,  shooter_chance = 0},
		{enemies = 3, spawn_delay = 0.55, shooter_chance = 0},
		{enemies = 4, spawn_delay = 0.5,  shooter_chance = 0},

		-- Fase de desafío moderado (oleadas 4-6): introducir shooters
		{enemies = 5, spawn_delay = 0.45, shooter_chance = 0.2},
		{enemies = 6, spawn_delay = 0.4,  shooter_chance = 0.3},
		{enemies = 7, spawn_delay = 0.38, shooter_chance = 0.35},

		-- Fase intensa (oleadas 7-9): mix balanceado
		{enemies = 8, spawn_delay = 0.35, shooter_chance = 0.4},
		{enemies = 9, spawn_delay = 0.32, shooter_chance = 0.45},
		{enemies = 10, spawn_delay = 0.3, shooter_chance = 0.5},
	},
	rescue = {
		{enemies = 4, spawn_delay = 0.45, shooter_chance = 0.25},
		{enemies = 5, spawn_delay = 0.4,  shooter_chance = 0.3},
		{enemies = 6, spawn_delay = 0.35, shooter_chance = 0.35},
	}
}

function init(self)
	self.current_wave = 0
	self.enemies_alive = 0
	self.enemies_to_spawn = 0
	self.spawn_timer = 0
	self.spawn_delay = 0.5
	self.spawned_enemies = {}

	-- Referencia al player activo
	self.active_player_id = go.get_id("/player")

	-- Cola de puntos a usar para spawn escalonado
	-- Ahora guarda {point, enemy_type}
	self.spawn_queue = {}

	-- Configuración de oleada actual
	self.current_shooter_chance = 0

	-- Modo rescate
	self.is_rescue_mode = false
	self.rescue_wave = 0

	-- NUEVO: Estado de boss fight
	self.is_boss_fight = false

	-- Cargar datos de la room actual
	self.room = room_data.current
	self.min_distance = room_data.config.min_distance_from_player

	print("[WaveManager] Inicializado")
	print("[WaveManager] Room: " .. self.room.name)
	print("[WaveManager] Spawn points disponibles: " .. #self.room.spawn_points)

	-- Comenzar primera oleada
	timer.delay(2.0, false, function()
		start_next_wave(self)
	end)
end

function update(self, dt)
	-- No spawnear durante boss fight
	if self.is_boss_fight then
		return
	end

	-- Spawn escalonado desde la cola
	if #self.spawn_queue > 0 then
		self.spawn_timer = self.spawn_timer - dt

		if self.spawn_timer <= 0 then
			local spawn_data = table.remove(self.spawn_queue, 1)
			spawn_enemy(self, spawn_data.point, spawn_data.enemy_type)
			self.spawn_timer = self.spawn_delay
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("enemy_died") then
		self.enemies_alive = self.enemies_alive - 1

		-- Remover de la lista de enemigos activos
		for i, enemy_id in ipairs(self.spawned_enemies) do
			if enemy_id == sender then
				table.remove(self.spawned_enemies, i)
				break
			end
		end

		print("[WaveManager] Enemigo eliminado. Restantes: " .. self.enemies_alive)

		-- No verificar wave complete durante boss fight
		if self.is_boss_fight then
			return
		end

		if self.enemies_alive <= 0 and #self.spawn_queue <= 0 then
			on_wave_complete(self)
		end
		return
	end

	if message_id == hash("pause_enemies") then
		print("[WaveManager] Pausando " .. #self.spawned_enemies .. " enemigos")
		for _, enemy_id in ipairs(self.spawned_enemies) do
			if go.exists(enemy_id) then
				msg.post(enemy_id, "pause")
			end
		end
		return
	end

	if message_id == hash("resume_enemies") then
		print("[WaveManager] Reanudando enemigos")
		for _, enemy_id in ipairs(self.spawned_enemies) do
			if go.exists(enemy_id) then
				msg.post(enemy_id, "resume")
			end
		end
		return
	end

	if message_id == hash("get_player_target") then
		if self.active_player_id then
			msg.post(message.requester, "set_target", { player_id = self.active_player_id })
		end
		return
	end

	if message_id == hash("update_player_target") then
		self.active_player_id = message.player_id
		print("[WaveManager] Player activo actualizado: " .. tostring(self.active_player_id))

		for _, enemy_id in ipairs(self.spawned_enemies) do
			if go.exists(enemy_id) then
				msg.post(enemy_id, "set_target", { player_id = self.active_player_id })
			end
		end
		return
	end

	if message_id == hash("start_rescue_mode") then
		-- NUEVO: Ignorar rescate durante boss fight
		if self.is_boss_fight then
			print("[WaveManager] Rescate ignorado - Boss fight activo")
			return
		end
		start_rescue_mode(self, message.fallen_pos)
		return
	end

	if message_id == hash("end_rescue_mode") then
		end_rescue_mode(self)
		return
	end

	-- NUEVO: Mensaje para iniciar boss fight
	if message_id == hash("boss_fight_started") then
		self.is_boss_fight = true
		print("[WaveManager] Boss fight iniciado - Desactivando spawns y rescate")
		-- Limpiar enemigos existentes para que el jugador se concentre en el boss
		clear_all_enemies(self)
		return
	end

	-- NUEVO: Mensaje para terminar boss fight
	if message_id == hash("boss_fight_ended") then
		self.is_boss_fight = false
		self.spawn_queue = {}  -- Limpiar cola por si acaso
		print("[WaveManager] Boss fight terminado - Sistema detenido")
		-- NO iniciamos nueva oleada, el juego terminó
		return
	end

	if message_id == hash("game_over") then
		self.spawn_queue = {}
		self.is_spawning = false
		print("[WaveManager] Detenido por Game Over")
		return
	end
end

-- ============================================================
-- HELPERS
-- ============================================================

-- NUEVO: Función para eliminar todos los enemigos activos
clear_all_enemies = function(self)
	print("[WaveManager] Limpiando " .. #self.spawned_enemies .. " enemigos...")

	-- Limpiar la cola de spawn
	self.spawn_queue = {}

	-- Eliminar todos los enemigos existentes
	for _, enemy_id in ipairs(self.spawned_enemies) do
		if go.exists(enemy_id) then
			-- Opción 1: Eliminar inmediatamente
			go.delete(enemy_id)

			-- Opción 2 (alternativa): Si quieres una muerte con animación
			-- msg.post(enemy_id, "force_die")
		end
	end

	-- Resetear contadores
	self.spawned_enemies = {}
	self.enemies_alive = 0

	print("[WaveManager] Todos los enemigos eliminados")
end

-- Obtiene la posición actual del jugador
get_player_position = function()
	local success, pos = pcall(function()
		return go.get_position("/player")
	end)

	if success then
		return pos
	else
		return vmath.vector3(room_data.current.player_spawn.x, room_data.current.player_spawn.y, 0)
	end
end

-- Filtra spawn points válidos (lejos del jugador)
get_valid_spawn_points = function(self, count)
	local player_pos = get_player_position()
	local valid_points = {}

	for _, point in ipairs(self.room.spawn_points) do
		local point_vec = vmath.vector3(point.x, point.y, 0)
		local distance = vmath.length(point_vec - player_pos)

		if distance >= self.min_distance then
			table.insert(valid_points, point)
		end
	end

	print("[WaveManager] Puntos válidos (lejos del jugador): " .. #valid_points .. "/" .. #self.room.spawn_points)

	-- Mezclar aleatoriamente (Fisher-Yates shuffle)
	for i = #valid_points, 2, -1 do
		local j = math.random(i)
		valid_points[i], valid_points[j] = valid_points[j], valid_points[i]
	end

	local selected = {}
	for i = 1, math.min(count, #valid_points) do
		table.insert(selected, valid_points[i])
	end

	return selected
end

-- Decide qué tipo de enemigo spawnear
get_enemy_type_for_wave = function(self)
	if math.random() < self.current_shooter_chance then
		return "shooter"
	else
		return "chaser"
	end
end

-- ============================================================
-- OLEADAS
-- ============================================================

start_next_wave = function(self)
	-- NUEVO: No iniciar oleadas durante boss fight
	if self.is_boss_fight then
		print("[WaveManager] Oleada cancelada - Boss fight activo")
		return
	end

	local config
	local wave_name

	if self.is_rescue_mode then
		self.rescue_wave = self.rescue_wave + 1

		if self.rescue_wave > #WAVE_CONFIG.rescue then
			on_rescue_waves_complete(self)
			return
		end

		config = WAVE_CONFIG.rescue[self.rescue_wave]
		wave_name = i18n.t("rescue_wave") .. " " .. self.rescue_wave .. "/3"
	else
		self.current_wave = self.current_wave + 1

		local wave_index = math.min(self.current_wave, #WAVE_CONFIG.normal)
		config = WAVE_CONFIG.normal[wave_index]

		-- ESCALADO INFINITO MEJORADO
		if self.current_wave > #WAVE_CONFIG.normal then
			local extra = self.current_wave - #WAVE_CONFIG.normal

			local enemy_bonus = math.floor(math.log(extra + 1) / math.log(2)) + 1
			local max_enemies = 15

			config = {
				enemies = math.min(config.enemies + enemy_bonus, max_enemies),
				spawn_delay = math.max(0.25, config.spawn_delay - (extra * 0.02)),
				shooter_chance = math.min(0.6, config.shooter_chance + (extra * 0.02))
			}
		end

		wave_name = i18n.t("wave") .. " " .. self.current_wave
	end

	-- Guardar chance actual para usar en get_enemy_type_for_wave
	self.current_shooter_chance = config.shooter_chance or 0

	print("[WaveManager] ═══════════════════════════")
	print("[WaveManager] " .. wave_name)
	print("[WaveManager] Enemigos: " .. config.enemies)
	print("[WaveManager] Shooter chance: " .. (self.current_shooter_chance * 100) .. "%")
	print("[WaveManager] ═══════════════════════════")

	-- Actualizar HUD (solo oleadas normales)
	if not self.is_rescue_mode then
		msg.post("/hud#hud", "update_wave", { wave = self.current_wave })
	end

	self.spawn_delay = config.spawn_delay

	local points = get_valid_spawn_points(self, config.enemies)

	local enemies_remaining = config.enemies
	while enemies_remaining > 0 do
		for _, point in ipairs(points) do
			if enemies_remaining <= 0 then break end

			-- Determinar tipo de enemigo
			local enemy_type = get_enemy_type_for_wave(self)

			table.insert(self.spawn_queue, {
				point = point,
				enemy_type = enemy_type
			})
			enemies_remaining = enemies_remaining - 1
		end
	end

	print("[WaveManager] Enemigos en cola: " .. #self.spawn_queue)
	self.spawn_timer = 0.3
end

-- ============================================================
-- SPAWN
-- ============================================================

spawn_enemy = function(self, point, enemy_type)
	-- NUEVO: No spawnear durante boss fight
	if self.is_boss_fight then
		return
	end

	local factory_url = ENEMY_FACTORIES[enemy_type]

	if not factory_url then
		print("[WaveManager] ERROR: Factory no encontrada para: " .. tostring(enemy_type))
		return
	end

	local pos = vmath.vector3(point.x, point.y, 0)
	local enemy_id = factory.create(factory_url, pos)

	if enemy_id then
		self.enemies_alive = self.enemies_alive + 1
		table.insert(self.spawned_enemies, enemy_id)
		print("[WaveManager] " .. enemy_type .. " spawneado: " .. tostring(enemy_id))
	else
		print("[WaveManager] ERROR: No se pudo crear " .. enemy_type)
	end
end

-- ============================================================
-- COMPLETAR OLEADAS
-- ============================================================

on_wave_complete = function(self)
	print("[WaveManager] ¡Oleada completada!")
	msg.post("/hud#hud", "show_message", { text = i18n.t("wave_complete"), duration = 1.5 })

	-- ¿Es hora del boss? (solo en modo normal, no en rescate)
	if not self.is_rescue_mode and self.current_wave >= BOSS_TRIGGER_WAVE then
		print("[WaveManager] ═══════════════════════════")
		print("[WaveManager]   ¡PREPARANDO BOSS FIGHT!  ")
		print("[WaveManager] ═══════════════════════════")

		timer.delay(2.0, false, function()
			msg.post("/game_manager", "start_boss_fight")
		end)
		return  -- No iniciar más oleadas
	end

	-- Continuar con siguiente oleada normal
	timer.delay(3.0, false, function()
		start_next_wave(self)
	end)
end


start_rescue_mode = function(self, fallen_pos)
	-- NUEVO: Verificación adicional de seguridad
	if self.is_boss_fight then
		print("[WaveManager] Rescate bloqueado durante boss fight")
		return
	end

	print("[WaveManager] ═══════════════════════════")
	print("[WaveManager]   INICIANDO OLEADAS RESCATE")
	print("[WaveManager] ═══════════════════════════")

	-- NUEVO: Limpiar enemigos de la oleada anterior
	print("[WaveManager] Limpiando enemigos anteriores antes del rescate...")
	clear_all_enemies(self)

	self.is_rescue_mode = true
	self.rescue_wave = 0
	self.spawn_queue = {}

	-- Pequeño delay para que el jugador se oriente
	timer.delay(1.0, false, function()
		start_next_wave(self)
	end)
end

end_rescue_mode = function(self)
	print("[WaveManager] Modo rescate terminado")

	-- NUEVO: Limpiar enemigos de rescate antes de continuar
	print("[WaveManager] Limpiando enemigos de rescate...")
	clear_all_enemies(self)

	self.is_rescue_mode = false
	self.rescue_wave = 0

	-- NUEVO: Verificar si debemos continuar con oleadas o si hay boss pendiente
	if self.is_boss_fight then
		print("[WaveManager] No se reanudan oleadas - Boss fight activo")
		return
	end

	timer.delay(2.0, false, function()
		start_next_wave(self)
	end)
end

on_rescue_waves_complete = function(self)
	print("[WaveManager] ═══════════════════════════")
	print("[WaveManager] ¡OLEADAS DE RESCATE COMPLETADAS!")
	print("[WaveManager] ═══════════════════════════")

	msg.post("/game_manager", "rescue_available")
end