-- game_manager.script
-- Controla el estado global: personajes, jugador activo, modo de juego

local camera = require "orthographic.camera"
local room_data = require "main.data.room_data"
local character_data = require "main.data.character_data"  -- NUEVO
local game_config = require "main.data.game_config"        -- NUEVO

-- ============================================================
-- ESTADOS DEL JUEGO
-- ============================================================

local STATE = {
	PLAYING = "playing",
	TRANSITIONING = "transitioning",
	RESCUE = "rescue",
	BOSS_FIGHT = "boss_fight",
	VICTORY = "victory",
	GAME_OVER = "game_over"
}

-- ============================================================
-- FORWARD DECLARATIONS
-- ============================================================

local handle_player_death
local handle_rescue_complete
local find_farthest_spawn_point
local handle_boss_fight
local handle_boss_defeated
local spawn_next_character  -- NUEVO

-- ============================================================
-- INIT
-- ============================================================

function init(self)
	math.randomseed(os.time())  -- NUEVO: Seed para aleatorización

	-- NUEVO: Sistema de cola de personajes
	self.character_queue = character_data.create_character_queue(game_config.is_demo)
	self.current_character_index = 0  -- Se incrementa en spawn_next_character
	self.active_character_id = nil    -- ID del personaje ("tank", "speedy", etc.)
	self.active_character_data = nil  -- Datos completos del personaje activo

	-- Estado del juego
	self.game_state = STATE.PLAYING
	self.active_player_id = nil       -- GO instance del player
	self.fallen_player_id = nil
	self.fallen_position = nil
	self.boss_id = nil

	-- NUEVO: Personajes caídos (para sistema de rescate múltiple futuro)
	self.fallen_characters = {}

	-- Log de la cola de personajes
	print("[GameManager] ═══════════════════════════")
	print("[GameManager] Cola de personajes:")
	for i, char_id in ipairs(self.character_queue) do
		local char = character_data.get(char_id)
		print("  " .. i .. ". " .. char.name)
	end
	print("[GameManager] ═══════════════════════════")

	-- Spawnear la bola al inicio del juego
	local ball_pos = vmath.vector3(
	room_data.current.ball_spawn.x,
	room_data.current.ball_spawn.y,
	0.5
)
factory.create("#ball_factory", ball_pos)
print("[GameManager] Bola spawneada en: " .. ball_pos.x .. ", " .. ball_pos.y)

-- NUEVO: Spawnear el primer personaje
local spawn_pos = vmath.vector3(
room_data.current.spawn_points[1].x,
room_data.current.spawn_points[1].y,
0
)
spawn_next_character(self, spawn_pos)

	print("[GameManager] Inicializado")

	-- Actualizar HUD inicial
	local remaining = #self.character_queue - self.current_character_index + 1
	msg.post("/hud#hud", "update_lives", { lives = remaining })
	end

	-- ============================================================
	-- NUEVO: SPAWN DE PERSONAJES
	-- ============================================================

	spawn_next_character = function(self, spawn_position)
	self.current_character_index = self.current_character_index + 1

	-- Verificar si quedan personajes
	if self.current_character_index > #self.character_queue then
		print("[GameManager] No quedan personajes!")
		return nil
	end

	-- Obtener datos del siguiente personaje
	local char_id = self.character_queue[self.current_character_index]
	local char_data = character_data.get(char_id)

	self.active_character_id = char_id
	self.active_character_data = char_data

	print("[GameManager] ═══════════════════════════")
	print("[GameManager] Spawneando: " .. char_data.name)
	print("[GameManager] Velocidad base: " .. char_data.base_speed)
	print("[GameManager] Habilidad: " .. char_data.ability_type)
	print("[GameManager] ═══════════════════════════")

	-- Crear el player GO
	self.active_player_id = factory.create("#player_factory", spawn_position)

	-- NUEVO: Enviar datos del personaje al player
	timer.delay(0, false, function()
		if self.active_player_id and go.exists(self.active_player_id) then
			msg.post(self.active_player_id, "set_character", {
				character_id = char_id,
				character_data = char_data
			})

			-- NUEVO: Invulnerabilidad inicial solo para personajes de respaldo (no el primero)
			if self.current_character_index > 1 then
				msg.post(self.active_player_id, "start_invulnerability", { duration = 2.0 })
			end
		end
	end)

	-- NUEVO: Notificar al wave_manager quién es el jugador actual
	timer.delay(0.1, false, function()
		if self.active_player_id and go.exists(self.active_player_id) then
			msg.post("/wave_manager", "update_player_target", {
				player_id = self.active_player_id
			})
			print("[GameManager] Target enviado a wave_manager: " .. tostring(self.active_player_id))
		end
	end)

	-- Notificar al HUD sobre el personaje activo y la cola
	timer.delay(0.1, false, function()
		-- Info del personaje activo
		msg.post("/hud#hud", "update_current_character", {
			character_id = char_id,
			character_name = char_data.name
		})

		-- Info de la cola (cuántos quedan)
		local remaining = #self.character_queue - self.current_character_index
		local next_char_id = nil
		if self.current_character_index < #self.character_queue then
			next_char_id = self.character_queue[self.current_character_index + 1]
		end

		msg.post("/hud#hud", "update_character_queue", {
			remaining = remaining,
			next_character_id = next_char_id
		})
	end)

	-- Configurar cámara
	local room = room_data.current
	local camera_id = go.get_id("/camera")

	if room.scrollable then
	camera.follow(camera_id, self.active_player_id)
	print("[GameManager] Cámara: follow activado")
	else
	go.set_position(vmath.vector3(room.camera_center.x, room.camera_center.y, 0), camera_id)
	print("[GameManager] Cámara: fija en centro")
	end

	return self.active_player_id
end

-- ============================================================
-- ON MESSAGE
-- ============================================================

function on_message(self, message_id, message, sender)
	if message_id == hash("register_player") then
	-- Ya no necesitamos esto para el ID, pero lo mantenemos por compatibilidad
	print("[GameManager] Player registrado: " .. tostring(sender))
	return
	end

	if message_id == hash("player_died") then
	handle_player_death(self, message)
	return
	end

	if message_id == hash("rescue_started") then
	print("[GameManager] Rescate iniciado - mantén E para rescatar")
	return
	end

	if message_id == hash("rescue_cancelled") then
	print("[GameManager] Rescate cancelado")
	return
	end

	if message_id == hash("rescue_available") then
	print("[GameManager] ═══════════════════════════")
	print("[GameManager] ¡Oleadas completadas!")
	print("[GameManager] Acércate al caído y mantén E")
	print("[GameManager] ═══════════════════════════")
	msg.post("/hud#hud", "show_message", { text = "¡RESCATA A TU COMPAÑERO!", duration = 2.0 })
	return
	end

	if message_id == hash("rescue_complete") then
	handle_rescue_complete(self)
	return
	end

	if message_id == hash("start_boss_fight") then
	handle_boss_fight(self)
	return
	end

	if message_id == hash("boss_defeated") then
	handle_boss_defeated(self)
	return
	end

	-- NUEVO: Solicitar información del personaje activo
	if message_id == hash("get_active_character") then
	msg.post(sender, "active_character_info", {
		character_id = self.active_character_id,
		character_data = self.active_character_data,
		remaining = #self.character_queue - self.current_character_index
	})
	return
end
-- NUEVO: Enemigo eliminado - dar EXP al jugador
if message_id == hash("enemy_killed") then
	local ability_data = require "main.data.ability_data"
	local exp_amount = ability_data.exp_rewards[message.enemy_type] or 10

	if self.active_player_id and go.exists(self.active_player_id) then
		msg.post(self.active_player_id, "grant_exp", { amount = exp_amount })
	end
	return
end
-- Tutorial completado - reenviar al player activo
if message_id == hash("tutorial_complete") then
	if self.active_player_id and go.exists(self.active_player_id) then
		msg.post(self.active_player_id, "tutorial_complete")
		print("[GameManager] Tutorial completado - notificado al player")
	end
	return
end
end

-- ============================================================
-- HELPER FUNCTIONS
-- ============================================================

find_farthest_spawn_point = function(self, from_position)
local spawn_points = room_data.current.spawn_points
local farthest_point = spawn_points[1]
local max_distance = 0

for _, point in ipairs(spawn_points) do
local point_vec = vmath.vector3(point.x, point.y, 0)
local distance = vmath.length(point_vec - from_position)

if distance > max_distance then
	max_distance = distance
	farthest_point = point
end
end

return vmath.vector3(farthest_point.x, farthest_point.y, 0)
end

-- ============================================================
-- PLAYER DEATH & RESCUE
-- ============================================================

handle_player_death = function(self, message)
-- NUEVO: Log del personaje que murió
local fallen_char = self.active_character_data
print("[GameManager] ═══════════════════════════")
print("[GameManager] ¡" .. fallen_char.name .. " ha caído!")
print("[GameManager] ═══════════════════════════")

local death_position = message.position
self.fallen_position = death_position

-- NUEVO: Guardar info del personaje caído
table.insert(self.fallen_characters, {
character_id = self.active_character_id,
position = death_position
})

-- Verificar si quedan personajes
if self.current_character_index < #self.character_queue then
print("[GameManager] Personaje " .. self.current_character_index .. "/" .. #self.character_queue)

self.game_state = STATE.TRANSITIONING

-- Eliminar player actual
if self.active_player_id and go.exists(self.active_player_id) then
	go.delete(self.active_player_id)
	self.active_player_id = nil
end

-- Crear fallen_player en posición de muerte
self.fallen_player_id = factory.create("#fallen_player_factory", death_position)
print("[GameManager] Fallen player creado: " .. tostring(self.fallen_player_id))

-- Pausar enemigos durante transición (solo si no es boss fight)
if self.game_state ~= STATE.BOSS_FIGHT then
	msg.post("/wave_manager", "pause_enemies")
end

-- Guardar si estamos en boss fight antes de la transición
local is_boss_fight = (self.game_state == STATE.BOSS_FIGHT)

-- Countdown con mensajes al HUD
print("[GameManager] 3...")
msg.post("/hud#hud", "show_message", { text = "3", duration = 0.9 })

timer.delay(1.0, false, function()
	print("[GameManager] 2...")
	msg.post("/hud#hud", "show_message", { text = "2", duration = 0.9 })
end)

timer.delay(2.0, false, function()
	print("[GameManager] 1...")
	msg.post("/hud#hud", "show_message", { text = "1", duration = 0.9 })
end)

timer.delay(3.0, false, function()
	-- NUEVO: Mostrar nombre del siguiente personaje
	local next_char_id = self.character_queue[self.current_character_index + 1]
	local next_char = character_data.get(next_char_id)
	print("[GameManager] ¡" .. next_char.name .. " al rescate!")
	msg.post("/hud#hud", "show_message", { text = "¡" .. next_char.name .. "!", duration = 1.5 })

	-- NUEVO: Usar spawn_next_character en lugar de factory.create directo
	local spawn_pos = find_farthest_spawn_point(self, death_position)
	spawn_next_character(self, spawn_pos)

	-- Notificar al wave_manager quién es el nuevo player
	msg.post("/wave_manager", "update_player_target", {
		player_id = self.active_player_id
	})

	-- Notificar al boss quién es el nuevo player (si existe)
	if self.boss_id and go.exists(self.boss_id) then
		msg.post(self.boss_id, "set_target", { player_id = self.active_player_id })
		print("[GameManager] Boss actualizado con nuevo target")
	end

	-- Cambiar estado según contexto
	if is_boss_fight then
		self.game_state = STATE.BOSS_FIGHT
		print("[GameManager] Rescate durante Boss Fight - Sin oleadas adicionales")

		local remaining = #self.character_queue - self.current_character_index + 1
		msg.post("/hud#hud", "update_lives", { lives = remaining })
	else
		self.game_state = STATE.RESCUE

		local remaining = #self.character_queue - self.current_character_index + 1
		msg.post("/hud#hud", "update_lives", { lives = remaining })
		msg.post("/hud#hud", "update_mode", { mode = "rescue" })

		msg.post("/wave_manager", "start_rescue_mode", {
			fallen_pos = death_position
		})
		msg.post("/wave_manager", "resume_enemies")
	end
end)
else
-- Sin personajes restantes: GAME OVER
self.game_state = STATE.GAME_OVER

if self.active_player_id and go.exists(self.active_player_id) then
	go.delete(self.active_player_id)
	self.active_player_id = nil
end

if self.boss_id and go.exists(self.boss_id) then
	go.delete(self.boss_id)
	self.boss_id = nil
end

print("[GameManager] ═══════════════════════════")
print("[GameManager]        GAME OVER           ")
print("[GameManager] ═══════════════════════════")

msg.post("/hud#hud", "show_message", { text = "GAME OVER", duration = 3.0 })
msg.post("/wave_manager", "game_over")
msg.post("/wave_manager", "pause_enemies")

timer.delay(3, false, function()
	print("[GameManager] Reiniciando...")
	msg.post("@system:", "reboot")
end)
end
end

handle_rescue_complete = function(self)
print("[GameManager] ═══════════════════════════")
print("[GameManager]    ¡RESCATE EXITOSO!       ")
print("[GameManager] ═══════════════════════════")

msg.post("/hud#hud", "show_message", { text = "¡RESCATE EXITOSO!", duration = 2.0 })

-- NUEVO: Recuperar el personaje caído a la cola
if #self.fallen_characters > 0 then
local rescued = table.remove(self.fallen_characters, 1)
table.insert(self.character_queue, rescued.character_id)
print("[GameManager] " .. rescued.character_id .. " recuperado a la cola")
end

self.fallen_player_id = nil
self.fallen_position = nil

self.game_state = STATE.PLAYING

-- Actualizar HUD
local remaining = #self.character_queue - self.current_character_index + 1
msg.post("/hud#hud", "update_lives", { lives = remaining })
msg.post("/hud#hud", "update_mode", { mode = "normal" })

-- Notificar al HUD sobre la cola actualizada
remaining = #self.character_queue - self.current_character_index
local next_char_id = nil
if self.current_character_index < #self.character_queue then
	next_char_id = self.character_queue[self.current_character_index + 1]
end

msg.post("/hud#hud", "update_character_queue", {
	remaining = remaining,
	next_character_id = next_char_id
})

msg.post("/wave_manager", "end_rescue_mode")
end

-- ============================================================
-- BOSS FIGHT
-- ============================================================

handle_boss_fight = function(self)
print("[GameManager] ═══════════════════════════")
print("[GameManager]       ¡BOSS FIGHT!         ")
print("[GameManager] ═══════════════════════════")

self.game_state = STATE.BOSS_FIGHT

msg.post("/wave_manager", "boss_fight_started")
msg.post("/hud#hud", "show_message", { text = "¡JEFE FINAL!", duration = 2.0 })
msg.post("/hud#hud", "update_mode", { mode = "boss" })

timer.delay(2.5, false, function()
local boss_pos = vmath.vector3(
room_data.current.boss_spawn and room_data.current.boss_spawn.x or 640,
room_data.current.boss_spawn and room_data.current.boss_spawn.y or 500,
0.5
)

self.boss_id = factory.create("#turtle_factory", boss_pos)
print("[GameManager] Boss spawneado: " .. tostring(self.boss_id))

timer.delay(0.1, false, function()
if self.boss_id and go.exists(self.boss_id) then
	msg.post(self.boss_id, "set_target", { player_id = self.active_player_id })
end
end)
end)
end

handle_boss_defeated = function(self)
print("[GameManager] ═══════════════════════════")
print("[GameManager]       ¡¡VICTORIA!!         ")
print("[GameManager] ═══════════════════════════")

self.game_state = STATE.VICTORY
self.boss_id = nil

msg.post("/wave_manager", "boss_fight_ended")
msg.post("/hud#hud", "show_message", { text = "¡¡VICTORIA!!", duration = 4.0 })
msg.post("/hud#hud", "update_mode", { mode = "victory" })

timer.delay(5.0, false, function()
print("[GameManager] Reiniciando juego...")
msg.post("@system:", "reboot")
end)
end