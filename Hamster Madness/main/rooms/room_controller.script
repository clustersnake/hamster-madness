function init(self)
	msg.post("/level_manager", "room_controller_ready", { id = go.get_id() })
	print("[RoomController] Init: " .. tostring(go.get_id()))
end

function on_message(self, message_id, message, sender)
	if message_id == hash("configure_doors") then
		local path_str = tostring(go.get_id())
		print("[RoomController] configure_doors recibido. tostring=" .. path_str)

		local full_path = string.match(path_str, "%[([^%]]+)%]")
		if not full_path then
			full_path = path_str
		end
		print("[RoomController] full_path=" .. tostring(full_path))

		local parent_path = string.match(full_path, "^(.*)/")
		if not parent_path then
			print("[RoomController] ERROR: no se pudo obtener padre")
			return
		end
		print("[RoomController] parent_path=" .. tostring(parent_path))

		for dir, state in pairs(message.door_states) do
			local door_path = parent_path .. "/door_" .. dir
			local door_id = hash(door_path)
			local exists = go.exists(door_id)
			print("[RoomController] " .. dir .. " -> path=" .. door_path .. " existe=" .. tostring(exists))
			if exists then
				msg.post(door_id, state)
			end
		end
	end
end
