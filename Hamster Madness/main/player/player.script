-- player.script
-- Controlador del jugador - Solo funciones de Defold

local actions = require "main.player.player_actions"
local animation = require "main.player.player_animation"
local player_camera = require "main.player.player_camera"

go.property("speed", 300)
go.property("invulnerability_time", 1.5)

-- ============================================================
-- FUNCIONES DE DEFOLD
-- ============================================================

function init(self)
	msg.post(".", "acquire_input_focus")
	self.tutorial_active = true
	-- Estado de movimiento
	self.direction = vmath.vector3(0, 0, 0)
	self.facing = vmath.vector3(0, -1, 0)
	self.correction = vmath.vector3(0, 0, 0)

	-- Estado del jugador
	self.has_projectile = false
	self.is_invulnerable = false
	self.is_alive = true

	-- Estado de rescate
	self.near_fallen = false
	self.fallen_id = nil
	self.is_rescuing = false

	-- Inicializar subsistemas
	animation.init_state(self)
	player_camera.setup(go.get_id())
	actions.set_shield_state(self, false)

	msg.post("/game_manager", "register_player")
	animation.update(self, true)

	-- Invulnerabilidad inicial para P2
	if string.find(tostring(msg.url()), "instance") then
		print("[Player] Soy P2 - activando invulnerabilidad inicial")
		actions.start_invulnerability(self, 2.0)
	end
end

function update(self, dt)
	if not self.is_alive then
		return
	end

	actions.apply_movement(self, dt)
	animation.update(self, false)
	actions.reset_frame_state(self)
end

function on_input(self, action_id, action)
	if not self.is_alive then
		return
	end

	-- Movimiento
	local move_dir = actions.MOVEMENT_MAP[action_id]
	if move_dir then
		self.direction = self.direction + move_dir
		if self.tutorial_active then
			msg.post("/tutorial_floor", "hide_move")
		end
		return true
	end

	-- Disparar
	if action_id == hash("shoot") and action.pressed then
		actions.fire_projectile(self)
		if self.tutorial_active then
			msg.post("/tutorial_floor", "hide_attack")
		end
		return true
	end

	-- Rescate
	if action_id == hash("rescue") then
		actions.handle_rescue_input(self, action)
		return true
	end
end

function on_message(self, message_id, message, sender)
	-- Colisiones físicas
	if message_id == hash("contact_point_response") then
		if message.group == hash("default") and message.distance > 0 then
			self.correction = self.correction + message.normal * message.distance
		end
		return
	end

	-- Recoger proyectil
	if message_id == hash("projectile_picked_up") then
		actions.set_shield_state(self, true)
		if self.tutorial_active then
			msg.post("/tutorial_floor", "show_attack")
		end
		print("¡Escudo recogido!")
		return
	end

	-- Recibir daño
	if message_id == hash("enemy_damage") then
		actions.take_damage(self, message.enemy_position or go.get_position())
		return
	end

	-- Zona de rescate
	if message_id == hash("trigger_response") and message.group == hash("fallen") then
		if message.enter then
			print("[Player] Cerca del caído - mantén E para rescatar")
			self.near_fallen = true
			self.fallen_id = message.other_id
		else
			print("[Player] Te alejaste del caído")
			actions.clear_rescue_state(self)
		end
		return
	end

	-- Rescate completado
	if message_id == hash("rescue_completed") then
		actions.clear_rescue_state(self)
		if self.tutorial_active then
			msg.post("/tutorial_floor", "hide_rescue")
		end
		print("[Player] Rescate completado - referencias limpiadas")
		return
	end

	if message_id == hash("tutorial_complete") then
		self.tutorial_active = false
		return
	end
end