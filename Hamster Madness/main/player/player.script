-- player.script
-- Controlador del jugador para Hamster Madness

local camera = require "orthographic.camera"

go.property("speed", 300)

function init(self)
	msg.post(".", "acquire_input_focus")

	self.direction = vmath.vector3(0, 0, 0)
	self.facing = vmath.vector3(0, 1, 0)
	self.correction = vmath.vector3(0, 0, 0)

	-- Estado del proyectil/escudo
	self.has_projectile = true
	self.projectile_id = nil

	-- Conectar cámara al jugador
	local camera_id = go.get_id("/camera")
	camera.follow(camera_id, go.get_id())

	-- Mostrar escudo al inicio (tiene proyectil)
	update_shield_visual(self)
end

function update(self, dt)
	if vmath.length(self.direction) > 0 then
		local normalized_direction = vmath.normalize(self.direction)
		local movement = normalized_direction * self.speed * dt
		local current_pos = go.get_position()
		go.set_position(current_pos + movement + self.correction)
		self.facing = normalized_direction
	else
		if vmath.length(self.correction) > 0 then
			local current_pos = go.get_position()
			go.set_position(current_pos + self.correction)
		end
	end

	self.direction = vmath.vector3(0, 0, 0)
	self.correction = vmath.vector3(0, 0, 0)
end

function on_input(self, action_id, action)
	-- Movimiento
	if action_id == hash("move_up") then
		self.direction.y = 1
	elseif action_id == hash("move_down") then
		self.direction.y = -1
	elseif action_id == hash("move_left") then
		self.direction.x = -1
	elseif action_id == hash("move_right") then
		self.direction.x = 1
	end

	-- Disparar
	if action_id == hash("shoot") and action.pressed then
		if self.has_projectile then
			fire_projectile(self)
		else
			print("No tienes proyectil - ¡recógelo primero!")
		end
	end
end

function fire_projectile(self)
	-- Posición de spawn (ligeramente adelante del jugador)
	local player_pos = go.get_position()
	local spawn_offset = self.facing * 50
	local spawn_pos = player_pos + spawn_offset
	spawn_pos.z = 0.5

	-- Crear el proyectil usando el factory
	local projectile_id = factory.create("#projectile_factory", spawn_pos)

	-- Guardar referencia
	self.projectile_id = projectile_id
	self.has_projectile = false

	-- Ocultar escudo
	update_shield_visual(self)

	-- Decirle al proyectil que se mueva
	msg.post(projectile_id, "fire", { direction = self.facing })

	print("¡Disparo!")
end

function update_shield_visual(self)
	if self.has_projectile then
		-- Mostrar escudo (opacidad completa)
		sprite.set_constant("#shield", "tint", vmath.vector4(1, 1, 1, 1))
	else
		-- Ocultar escudo (transparente)
		sprite.set_constant("#shield", "tint", vmath.vector4(1, 1, 1, 0))
	end
end

function on_message(self, message_id, message, sender)
	-- Colisiones
	if message_id == hash("contact_point_response") then
		-- Solo aplicar corrección para paredes (group "default")
		-- Ignorar colisiones con proyectil para no ser empujado
		if message.group == hash("default") then
			if message.distance > 0 then
				local correction = message.normal * message.distance
				self.correction = self.correction + correction
			end
		end
	end

	-- Recoger proyectil
	if message_id == hash("projectile_picked_up") then
		self.has_projectile = true
		self.projectile_id = nil

		-- Mostrar escudo
		update_shield_visual(self)

		print("¡Proyectil recogido! Escudo activo.")
	end
end