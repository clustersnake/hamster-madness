-- fallen_player.script
-- Representa al jugador caído esperando ser rescatado

go.property("rescue_time", 2.0)  -- Tiempo para completar rescate

function init(self)
	self.is_being_rescued = false
	self.rescue_progress = 0
	self.rescuer_id = nil

	print("[FallenPlayer] Esperando rescate...")
end

function on_message(self, message_id, message, sender)
	-- Detectar cuando P2 entra en el trigger
	if message_id == hash("trigger_response") then
		if message.enter and message.group == hash("player") then
			print("[FallenPlayer] ¡Rescatador detectado!")
			self.rescuer_id = message.other_id

			-- Notificar que puede iniciar rescate
			msg.post("/game_manager", "rescue_started")

		elseif not message.enter and message.group == hash("player") then
			print("[FallenPlayer] Rescatador se alejó")
			self.rescuer_id = nil
			self.rescue_progress = 0
			self.is_being_rescued = false

			-- Notificar que se canceló
			msg.post("/game_manager", "rescue_cancelled")
		end
	end

	-- Mensaje para avanzar el rescate (cuando P2 mantiene presionado E)
	if message_id == hash("rescue_hold") then
		if self.rescuer_id then
			self.is_being_rescued = true
		end
	end

	-- Mensaje para soltar el rescate
	if message_id == hash("rescue_release") then
		self.is_being_rescued = false
		self.rescue_progress = 0
	end
end

function update(self, dt)
	if self.is_being_rescued then
		self.rescue_progress = self.rescue_progress + dt

		-- Mostrar progreso (temporal, luego será UI)
		local percent = math.floor((self.rescue_progress / self.rescue_time) * 100)
		if percent % 25 == 0 then
			print("[FallenPlayer] Rescate: " .. percent .. "%")
		end

		-- ¿Rescate completado?
		if self.rescue_progress >= self.rescue_time then
			print("[FallenPlayer] ¡RESCATE COMPLETADO!")

			-- Notificar al rescatador que limpie sus referencias
			if self.rescuer_id then
				msg.post(self.rescuer_id, "rescue_completed")
			end

			-- Notificar al game manager
			msg.post("/game_manager", "rescue_complete")

			-- Eliminarse
			go.delete()
		end
	end
end