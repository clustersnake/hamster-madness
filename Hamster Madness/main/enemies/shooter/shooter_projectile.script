-- /main/enemies/shooter/enemy_projectile.script

go.property("direction", vmath.vector3(1, 0, 0))
go.property("speed", 150)
go.property("damage", 1)
go.property("lifetime", 5)

function init(self)
	self.timer = 0
end

function update(self, dt)
	-- Movimiento
	local pos = go.get_position()
	pos = pos + self.direction * self.speed * dt
	go.set_position(pos)

	-- Rotación visual hacia dirección
	local angle = math.atan2(self.direction.y, self.direction.x)
	go.set_rotation(vmath.quat_rotation_z(angle))

	-- Destruir después de un tiempo
	self.timer = self.timer + dt
	if self.timer > self.lifetime then
		go.delete()
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("collision_response") then
		local group = message.group

		if group == hash("player") then
			msg.post(message.other_id, "take_damage", { damage = self.damage })
			go.delete()

		elseif group == hash("walls") then
			-- Opcional: partículas de impacto
			go.delete()
		end
	end
end