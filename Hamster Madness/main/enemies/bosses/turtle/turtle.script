-- turtle.script
-- Boss: Tortuga con 3 fases

local states = require "main.enemies.bosses.turtle.turtle_states"
local common = require "main.shared.entity_common"

-- ============================================================
-- PROPIEDADES CONFIGURABLES
-- ============================================================

go.property("max_health", 3)
go.property("walk_speed", 60)

-- Aplastón normal
go.property("aplaston_range", 120)
go.property("aplaston_radius", 150)
go.property("aplaston_telegraph", 0.8)
go.property("aplaston_recovery", 1.2)

-- Ataque especial (Mega/Rodada)
go.property("special_cooldown_max", 8.0)
go.property("charge_duration", 1.5)

-- Rodada
go.property("rodada_speed", 350)

-- Parry
go.property("parry_duration", 2.0)

-- Vulnerable
go.property("vulnerable_duration", 3.0)

-- ============================================================
-- INIT
-- ============================================================

function init(self)
	-- Estado común (player_id, is_alive, is_paused, etc.)
	common.init_state(self)

	-- Estado del boss
	self.current_state = nil
	self.state_timer = 0

	-- Vida y fase
	self.health = self.max_health
	self.current_phase = 1

	-- Flags
	self.can_be_damaged = false
	self.is_parrying = false

	-- Cooldowns
	self.special_cooldown = 0

	-- Rodada
	self.rodada_direction = vmath.vector3(1, 0, 0)
	self.rodada_bounces = 0
	self.max_bounces = 5

	print("[Turtle] ═══════════════════════════")
	print("[Turtle]   BOSS INICIALIZADO        ")
	print("[Turtle]   Vida: " .. self.health)
	print("[Turtle]   Fase: " .. self.current_phase)
	print("[Turtle] ═══════════════════════════")

	states.change_state(self, states.STATE.INTRO)
end

-- ============================================================
-- UPDATE
-- ============================================================

function update(self, dt)
	if not common.can_act(self) then
		return
	end

	states.update(self, dt)

	if self.special_cooldown > 0 then
		self.special_cooldown = self.special_cooldown - dt
	end
end

-- ============================================================
-- MENSAJES
-- ============================================================

function on_message(self, message_id, message, sender)
	-- Mensajes comunes (pause, resume, set_target)
	-- Nota: NO usamos take_damage de common porque el boss tiene lógica especial
	if message_id == hash("pause") or 
	message_id == hash("resume") or 
	message_id == hash("set_target") then
		common.handle_message(self, message_id, message, sender)
		return
	end

	-- Colisiones físicas
	if message_id == hash("contact_point_response") then
		handle_collision(self, message)
		return
	end

	-- Trigger con proyectil (alternativa)
	if message_id == hash("trigger_response") then
		if message.group == hash("projectile") and message.enter then
			handle_projectile_hit(self, message)
		end
		return
	end
end

-- ============================================================
-- COLISIONES (funciones locales)
-- ============================================================

function handle_collision(self, message)
	-- Rebote en paredes durante rodada
	if message.group == hash("default") then
		handle_wall_collision(self, message)
		return
	end

	-- Daño al jugador por contacto
	if message.group == hash("player") then
		common.damage_player(self, message.other_id)
		return
	end

	-- Impacto con proyectil
	if message.group == hash("projectile") then
		handle_projectile_hit(self, message)
		return
	end
end

function handle_wall_collision(self, message)
	if self.current_state ~= states.STATE.RODADA then
		return
	end

	local bounced = common.handle_wall_bounce(self, message.normal, {
		direction_field = "rodada_direction",
		bounce_field = "rodada_bounces",
		max_bounces = self.max_bounces,
		on_max_bounces = function(boss)
			states.on_rodada_complete(boss)
		end
	})

	-- Aplicar variación al ángulo después del rebote
	if bounced then
		states.apply_bounce_variation(self)
	end
end

function handle_projectile_hit(self, message)
	local result = states.on_hit_by_projectile(self)

	if result == "damage" then
		apply_damage(self)

	elseif result == "parry" then
		reflect_projectile(self, message.other_id)

	elseif result == true then
		-- Volteada durante rodada
		msg.post(message.other_id, "destroy")
	end
end

-- ============================================================
-- DAÑO AL BOSS
-- ============================================================

function apply_damage(self)
	self.health = self.health - 1
	print("[Turtle] ¡DAÑO! Vida restante: " .. self.health)

	states.on_damage_taken(self)

	if self.health <= 0 then
		states.change_state(self, states.STATE.DEAD)
	else
		advance_phase(self)
	end
end

function advance_phase(self)
	self.current_phase = self.current_phase + 1

	print("[Turtle] ═══════════════════════════")
	print("[Turtle]      ¡FASE " .. self.current_phase .. "!")
	print("[Turtle] ═══════════════════════════")

	self.special_cooldown = self.special_cooldown_max
	states.change_state(self, states.STATE.IDLE)
end

-- ============================================================
-- PARRY / REFLEJO
-- ============================================================

function reflect_projectile(self, projectile_id)
	local boss_pos = go.get_position()
	local to_player = vmath.vector3(0, -1, 0)

	if common.has_valid_target(self) then
		local player_pos = go.get_position(self.player_id)
		to_player = vmath.normalize(player_pos - boss_pos)
	end

	-- Variación aleatoria para que no sea 100% preciso
	local variation = (math.random() - 0.5) * 0.5
	local angle = math.atan2(to_player.y, to_player.x) + variation
	local reflected_dir = vmath.vector3(math.cos(angle), math.sin(angle), 0)

	msg.post(projectile_id, "reflect", {
		direction = reflected_dir
	})

	print("[Turtle] ¡PARRY! Proyectil reflejado hacia el jugador")
end