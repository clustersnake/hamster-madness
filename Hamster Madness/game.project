[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 1280
height = 720
high_dpi = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01
use_fixed_timestep = 1
fixed_update_frequency = 60

[html5]
scale_mode = stretch

[project]
title = Hamster Madness


[input]
use_accelerometer = 0

