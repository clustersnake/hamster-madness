[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 1280
height = 720
high_dpi = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = stretch

[project]
title = Hamster Madness
dependencies#0 = https://github.com/britzl/defold-orthographic/archive/master.zip

[input]
use_accelerometer = 0

