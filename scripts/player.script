go.property("muzzle_offset", 1.0)
go.property("aim_height", 0.5)

local hash_shoot = hash("shoot")
local hash_recover_shield = hash("recover_shield")

local function update_shield_state(self)
	if self.has_shield then
		msg.post("#shield_sprite", "enable")
		msg.post("#shield_collision", "enable")
	else
		msg.post("#shield_sprite", "disable")
		msg.post("#shield_collision", "disable")
	end
end

local function fire_projectile(self)
	self.has_shield = false
	update_shield_state(self)

	local pos = go.get_world_position() + self.aim_dir * self.muzzle_offset
	pos.y = self.aim_height
	local bullet_id = factory.create("#bullet_factory", pos)

	-- Enviamos la dirección de apuntado (aim_dir) y la referencia del dueño a la bala
	msg.post(bullet_id, "set_dir", { dir = self.aim_dir })
	msg.post(bullet_id, "set_owner", { owner = go.get_id() })
end

function init(self)
	msg.post(".", "acquire_input_focus")

	self.has_shield = true
	-- Dirección de apuntado por defecto (hacia la derecha)
	self.aim_dir = vmath.vector3(1, 0, 0)
	-- Reticulo: punto del suelo bajo el cursor
	self.aim_ground = nil

	update_shield_state(self)
end

function on_input(self, action_id, action)
	-- 1. Capturar el movimiento del mouse (action_id es nil cuando el mouse se mueve)
	-- if not action_id then
	if action.screen_x and action.screen_y then
		-- Punto del near plane de la cámara bajo el cursor
		local w = camera.screen_xy_to_world(action.screen_x, action.screen_y, "/camera#camera")

		-- Vector forward de la cámara (Defold mira hacia -Z local)
		local cam_q = go.get_world_rotation("/camera#camera")
		local fwd = vmath.rotate(cam_q, vmath.vector3(0, 0, -1))

		-- Intersección del rayo de cámara con el plano del suelo (Y = 0)
		if fwd.y ~= 0 then
			local t = -w.y / fwd.y
			if t >= 0 then
				local ground = w + fwd * t
				self.aim_ground = ground
				local d = ground - go.get_world_position()
				d.y = 0 -- Mantenemos el proyectil horizontal al plano
				if vmath.length_sqr(d) > 0 then
					self.aim_dir = vmath.normalize(d)
				end
			end
		end
	end

	-- 2. Disparo
	if action_id == hash_shoot and action.pressed then
		if self.has_shield then
			fire_projectile(self)
		end
	end
end

function update(self, dt)
	-- Mover el retículo al punto del suelo bajo el cursor
	if self.aim_ground then
		go.set_position(vmath.vector3(self.aim_ground.x, self.aim_height, self.aim_ground.z), "crosshair")
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash_recover_shield then
		self.has_shield = true
		update_shield_state(self)
	end
end